# MongoDB Atlas connection string, including the database name.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/navaro-crm

# Session signing secret. Must be at least 32 random characters.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Optional. Session lifetime, e.g. 7d, 12h, 30m. Defaults to 7d.
JWT_EXPIRES_IN=7d

# Required in production. Used to build links in outgoing emails.
APP_URL=http://localhost:3000

# Optional. Lead-assignment emails are skipped when this is unset.
RESEND_API_KEY=
EMAIL_FROM=Navaro CRM <noreply@navaro.com>

# Used only by `npm run seed` — never read at runtime.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=change-this-password
SEED_SUPERADMIN_FIRST_NAME=Admin
SEED_SUPERADMIN_LAST_NAME=User
